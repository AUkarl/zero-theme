{{- /* ============================================================
  rss.xml — RSS 订阅模板
  ------------------------------------------------------------
  输出策略（可在 config/_default/params.toml 的 [rss] 下调整）：
  - full_content = true（默认）  正文字段输出「完整正文」，图片/代码块/列表/表格/公式全保留
    = false 时只输出摘要（front matter 的 summary，没有就取正文开头）
  - 封面：front matter 的 image/img/cover（或 images 第一张）→ 既写进正文第一张 <img>，
    也写成 <enclosure> + <media:thumbnail>，列表缩略图和正文图都能看到
  - 视频/音频/音乐播放器整块删掉：阅读器里播不了，内嵌 <script>/<iframe> 还会破坏 feed
  - 正文同时写入 <description> 与 <content:encoded>（兼容各类阅读器）
  - limit 控制条目数量，默认 50
  - 站点名/描述/作者一律走 partials/site-config.html（后台「基本信息」写的 data/site.json），
    和浏览器标签、落地页、404 同一个口径，避免 feed 里顶着示例站的旧名字
  ============================================================ */ -}}
{{- $siteCfg := partial "site-config.html" . -}}
{{- $siteName := $siteCfg.name | default .Site.Title -}}
{{- $rss := .Site.Params.rss | default dict -}}
{{- if (ne $rss.enable false) -}}
{{- $full := (ne $rss.full_content false) -}}
{{- $limit := $rss.limit | default 50 -}}
{{- /* 媒体类短代码的外层容器：video-player/audio-player 是本地上传的播放器，
       shortcode-embed / *-music / *-video 是第三方嵌入，全部整块剔除 */ -}}
{{- $embedRe := `(?s)<div[^>]*class="[^"]*(?:video-embed|audio-player|video-player|shortcode-embed|music163-embed|bilibili-embed|netease-music|kugou-music|qq-music|bilibili-video|tencent-video|youku-video|youtube-video|youtube-embed)[^"]*"[^>]*>.*?</div>` -}}
{{- /* 作者标识 → 显示名：data/authors.yaml 的 name > 站长名字 > 标识本身 */ -}}
{{- $authorsData := hugo.Data.authors | default dict -}}
{{- $ownerId := trim (string ($siteCfg.defaultAuthor | default .Site.Params.default_author | default "")) " " -}}
{{- $ownerName := "" -}}
{{- with index $authorsData $ownerId -}}{{- $ownerName = string .name -}}{{- end -}}
{{- if not $ownerName -}}{{- $ownerName = trim (string ($siteCfg.author | default "")) " " -}}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ if or .IsHome (eq .Title $siteName) }}{{ $siteName }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ $siteName }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $siteCfg.description | default (printf "Recent content on %s" $siteName) }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Locale }}</language>{{ with .Site.Copyright }}
    <copyright>{{.}}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" -}}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end -}}
    {{- /* 分页/分区 feed 必须只取当前页面的 RegularPages；
           以前固定用 site.RegularPages，于是 /home/index.xml、/tags/edge/index.xml
           全都输出同一份全站 feed，页面里的 alternate 声明与实际内容对不上。
           首页仍取全站，其它上下文取当前 section/taxonomy。 */ -}}
    {{- /* /home/ 是站点首页（文章仍在 /posts/），它的 .RegularPages 是空的；
           站点根 / 与 /home/ 都取全站文章；其它 section/taxonomy 取当前页面的 RegularPages。
           moments 的类型是 moment，别漏掉；否则 /moments/index.xml 会是一份空 feed。 */ -}}
    {{- $rssPages := .RegularPages -}}
    {{- if .IsHome }}{{ $rssPages = site.RegularPages }}
    {{- else if eq .Section "home" }}{{ $rssPages = where site.RegularPages "Section" "in" (site.Params.mainSections | default (slice "posts")) }}{{ end -}}
    {{- $rssTypes := slice "post" "posts" "article" "blog" "shuo" "moment" "moments" -}}
    {{- if or (eq .Section "moments") (eq .Type "moments") }}{{ $rssTypes = slice "moment" "moments" }}
    {{- else if eq .Section "home" }}{{ $rssTypes = slice "post" "posts" "article" "blog" "shuo" }}{{ end -}}
    {{- $rssPages = where $rssPages "Type" "in" $rssTypes -}}
    {{- range $rssPages.ByDate.Reverse | first $limit }}
    {{- $html := .Summary -}}
    {{- if $full }}{{ $html = .Content }}{{ end -}}
    {{- /* ---------- 封面：给阅读器一个"原图直链" ----------
           支持的写法：image / img / cover 单个字段，或 images 列表（取第一张）。
           注意：这里刻意不调用 img-src.html —— 那会为每篇文章做一次远程取图，
           既拖慢构建又多一次网络依赖；直接用原地址转绝对路径就够了。 */ -}}
    {{- $cover := partial "one-string.html" (.Params.image | default .Params.img | default .Params.cover) -}}
    {{- if not $cover -}}
      {{- with .Params.images -}}
        {{- if reflect.IsSlice . -}}{{- $cover = index . 0 -}}{{- else -}}{{- $cover = . -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $coverURL := "" -}}
    {{- with $cover -}}{{- $coverURL = . | absURL -}}{{- else -}}{{- with $rss.cover_image -}}{{- $coverURL = . | absURL -}}{{- end -}}{{- end -}}
    {{- /* 正文里没有这张封面时，把它补到最前面：
           阅读器只看正文里的 <img>，正文有插图但没封面时照样要显示封面。
           已经出现过（同一个地址）就不重复插。 */ -}}
    {{- if $coverURL -}}
      {{- $dup := or (in $html $coverURL) (in $html $cover) -}}
      {{- if not $dup -}}
        {{- $html = printf "<p><img src=%q alt=%q loading=\"lazy\"></p>%s" $coverURL (.Title | plainify) $html -}}
      {{- end -}}
    {{- end -}}
    {{- /* ---------- 正文图片：把懒加载属性换成真实原图 ----------
           管线输出的 <img> 只有 data-src（WebP），外加一张内联的模糊占位图。
           阅读器不跑 JS，于是正文图要么空白、要么只剩那张极小的占位图。
           这里统一：占位图删掉，data-orig（原图）优先，其次 data-src，最后 src。 */ -}}
    {{- $html = replaceRE `(?s)<img\b[^>]*class="[^"]*img-pair-lqip[^"]*"[^>]*>` "" $html -}}
    {{- range findRE `(?s)<img\b[^>]*>` $html -}}
      {{- $tag := . -}}
      {{- $u := "" -}}
      {{- with (findRE `data-orig="([^"]+)"` $tag 1) -}}{{- $u = replaceRE `(?s).*data-orig="([^"]+)".*` "$1" (index . 0) -}}{{- end -}}
      {{- if not $u -}}{{- with (findRE `data-src="([^"]+)"` $tag 1) -}}{{- $u = replaceRE `(?s).*data-src="([^"]+)".*` "$1" (index . 0) -}}{{- end -}}{{- end -}}
      {{- if not $u -}}{{- with (findRE `[[:space:]]src="([^"]+)"` $tag 1) -}}{{- $u = replaceRE `(?s).*[[:space:]]src="([^"]+)".*` "$1" (index . 0) -}}{{- end -}}{{- end -}}
      {{- $alt := "" -}}
      {{- with (findRE `alt="([^"]*)"` $tag 1) -}}{{- $alt = replaceRE `(?s).*alt="([^"]*)".*` "$1" (index . 0) -}}{{- end -}}
      {{- if and $u (not (hasPrefix $u "data:")) -}}
        {{- $html = replace $html $tag (printf `<img src="%s" alt="%s" loading="lazy">` ($u | absURL) $alt) -}}
      {{- else -}}
        {{- $html = replace $html $tag "" -}}
      {{- end -}}
    {{- end -}}
    {{- /* ---------- 视频/音频：阅读器里播不了，整块隐藏 ----------
           （以前会换成一条 ▶ 链接，用户要求 feed 里不出现这些，直接删） */ -}}
    {{- $html = replace $html `href="//` `href="https://` -}}
    {{- $html = replaceRE `(?s)<script\b[^>]*>.*?</script>` "" $html -}}
    {{- $html = replaceRE $embedRe "" $html -}}
    {{- $html = replaceRE `(?s)<iframe\b[^>]*/?>(?:.*?</iframe>)?` "" $html -}}
    {{- $html = replaceRE `(?s)<audio\b[^>]*/?>(?:.*?</audio>)?` "" $html -}}
    {{- $html = replaceRE `(?s)<video\b[^>]*/?>(?:.*?</video>)?` "" $html -}}
    {{- $html = replaceRE `(?s)<!--.*?-->` "" $html -}}
    {{- /* XMLEscape 后由阅读器还原成 HTML：这是 RSS 的规范做法，避免 feed 结构非法 */ -}}
    {{- $html = $html | transform.XMLEscape -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- /* 署名：文章 front matter 的 author（一个或一串标识）> 默认作者标识。
             标识 → 显示名的顺序和文章页、seo.html 一致：authors.yaml 的 name → 站长名字 → 标识本身。
             以前直接把标识写进 dc:creator，阅读器里就顶着个 "default"。 */ -}}
      {{- $authorIds := slice -}}
      {{- $authorParam := .Params.author | default $ownerId -}}
      {{- if $authorParam -}}
        {{- $src := cond (reflect.IsSlice $authorParam) $authorParam (slice $authorParam) -}}
        {{- range $src -}}{{- $t := trim (string .) " " -}}{{- if $t -}}{{- $authorIds = $authorIds | append $t -}}{{- end -}}{{- end -}}
      {{- end -}}
      {{- $names := slice -}}
      {{- range $id := $authorIds -}}
        {{- $n := "" -}}
        {{- with index $authorsData $id -}}{{- with .name -}}{{- $n = string . -}}{{- end -}}{{- end -}}
        {{- if not $n -}}{{- $n = $ownerName -}}{{- end -}}
        {{- if not $n -}}{{- $n = $id -}}{{- end -}}
        {{- $names = $names | append $n -}}
      {{- end -}}
      {{- if $names }}<dc:creator>{{ delimit (uniq $names) ", " }}</dc:creator>{{ end }}
      {{- /* categories / tags 兼容两种写法：列表 或 单个字符串 */ -}}
      {{- with .Params.categories -}}
        {{- if reflect.IsSlice . -}}{{- range . }}<category>{{ . }}</category>{{ end -}}
        {{- else }}<category>{{ . }}</category>{{ end -}}
      {{- end -}}
      {{- with .Params.tags -}}
        {{- if reflect.IsSlice . -}}{{- range . }}<category>{{ . }}</category>{{ end -}}
        {{- else }}<category>{{ . }}</category>{{ end -}}
      {{- end }}
      <description>{{ $html | safeHTML }}</description>
      <content:encoded>{{ $html | safeHTML }}</content:encoded>
      {{- /* 封面以 enclosure / media:thumbnail 形式给出来：多数阅读器用这两个字段显示列表缩略图 */ -}}
      {{- with $coverURL }}
      {{- $ctype := "image/jpeg" -}}
      {{- if strings.HasSuffix . ".png" }}{{ $ctype = "image/png" }}{{ else if strings.HasSuffix . ".webp" }}{{ $ctype = "image/webp" }}{{ else if strings.HasSuffix . ".gif" }}{{ $ctype = "image/gif" }}{{ else if strings.HasSuffix . ".avif" }}{{ $ctype = "image/avif" }}{{ end -}}
      <enclosure url="{{ . }}" type="{{ $ctype }}" length="0" />
      <media:thumbnail url="{{ . }}" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
{{- else -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $siteName }}</title>
    <link>{{ .Site.BaseURL }}</link>
    <description>RSS is disabled.</description>
  </channel>
</rss>
{{- end -}}
